# Copy this file to hosting/restic.env, fill in the values, and keep that copy
# local. It is ignored by Git because it contains your B2 application key.

# Create a private bucket and a restricted app key in Backblaze B2.
RESTIC_REPOSITORY=b2:YOUR_BUCKET_NAME:familyhub
B2_ACCOUNT_ID=YOUR_B2_KEY_ID
B2_ACCOUNT_KEY=YOUR_B2_APPLICATION_KEY

# Use an absolute path to a local text file containing one long, unique backup
# passphrase. Do not put that passphrase in this file or in source control.
RESTIC_PASSWORD_FILE=C:\Family Hub\hosting\restic-password.txt
